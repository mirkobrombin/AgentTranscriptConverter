package transcript.converter

import std.text

struct options {
    source String = ""
    output String = ""
    sessionID String = ""
    codexHome String = ""
    claudeHome String = ""
    help bool = false
}

fn takesValue(name String) bool {
    name == "--output" || name == "--session-id" || name == "--codex-home" ||
        name == "--claude-home"
}

fn assignOption(&result options, name String, $value String) Result<void, failure> {
    if name == "--output" {
        result.output = value
        return .Ok
    }
    if name == "--codex-home" {
        result.codexHome = value
        return .Ok
    }
    if name == "--claude-home" {
        result.claudeHome = value
        return .Ok
    }
    const id = UUID.Parse(value) else {
        return .Err(fault(.InvalidArguments, "--session-id needs a UUID, not " + value))
    }
    result.sessionID = id.String()
    .Ok
}

fn parseOptions(args [String]) Result<own options, failure> {
    var result = own options {}
    var index usize = 0
    while index < len(args) {
        const value = text.Copy(args[index])
        if value == "-h" || value == "--help" {
            result.help = true
            index = index + 1
            continue
        }
        if takesValue(value) {
            if index + 1 >= len(args) {
                return .Err(fault(.InvalidArguments, value + " needs a value"))
            }
            assignOption(&result, value, text.Copy(args[index + 1])) else error {
                return .Err(error)
            }
            index = index + 2
            continue
        }
        if text.StartsWith(value, "-") {
            return .Err(fault(.InvalidArguments, "unknown option " + value))
        }
        if !text.IsEmpty(result.source) {
            return .Err(fault(.InvalidArguments, "only one source can be converted at a time"))
        }
        result.source = value
        index = index + 1
    }
    if !result.help && text.IsEmpty(result.source) {
        return .Err(fault(.InvalidArguments, "a Codex rollout path or session id is required"))
    }
    .Ok(result)
}
