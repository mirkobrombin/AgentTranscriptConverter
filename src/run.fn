package transcript.converter

import std.bytes
import std.format
import std.fs
import std.text

// Codex writes whole tool outputs, images included, on one line.
fn lineLimit() u64 {
    268435456
}

// Records are written in chunks so memory stays bounded by the longest line
// rather than by the length of the session.
fn chunkLimit() u64 {
    8388608
}

struct sink {
    file own fs.File
    batch own text.Builder
    size u64
}

struct sinkOutcome {
    target own sink
    result Result<void, failure>
}

struct conversion {
    counts tally
    memories own memoryTracker
}

fn drain(&conv converter, &batch text.Builder) u64 {
    var added u64 = 0
    var draining = true
    while draining {
        const next = conv.Next()
        match next {
            None: {
                draining = false
            }
            Some(line): {
                added = added + text.ByteLen(line) + 1
                append(&batch, line)
                append(&batch, "\n")
            }
        }
    }
    added
}

task writeBatch($target own sink) sinkOutcome {
    var current = target
    const data = current.batch.Finish() else {
        return sinkOutcome {
            target = current
            result = .Err(fault(.OutputUnavailable, "the output buffer closed early"))
        }
    }
    current.batch = text.NewBuilder()
    current.size = 0
    const sink { file batch size } = current
    const writing = spawn fs.WriteFileChunk($file, bytes.FromText(data))
    const outcome = $writing.wait()
    const fs.FileOutcome { File as returned Value as written } = outcome
    const result Result<void, failure> = match written {
        Ok: .Ok
        Err(error): .Err(fault(.OutputUnavailable, "cannot write the transcript"))
    }
    sinkOutcome {
        target = own sink { file = returned batch = batch size = size }
        result = result
    }
}

task closeSink($target own sink) Result<void, failure> {
    var current = target
    if current.size > 0 {
        const writing = spawn writeBatch($current)
        const outcome = $writing.wait()
        const sinkOutcome { target as returned result } = outcome
        current = returned
        result else error {
            return .Err(error)
        }
    }
    const sink { file batch size } = current
    discard batch
    const syncing = spawn fs.SyncFile($file)
    const synced = $syncing.wait()
    const fs.FileOutcome { File as closing Value as flushed } = synced
    flushed else {
        return .Err(fault(.OutputUnavailable, "cannot flush the transcript"))
    }
    var handle = closing
    const closed = handle.Close() else {
        return .Err(fault(.OutputUnavailable, "cannot close the transcript"))
    }
    discard closed
    .Ok
}

// Appends records to the end of an existing transcript.
task appendText($target String, $data String) Result<void, failure> {
    const opening = spawn fs.OpenFile($target, .Write)
    const openedFile = $opening.wait()
    const file = openedFile else {
        return .Err(fault(.OutputUnavailable, "cannot open the transcript"))
    }
    const sizing = spawn fs.SizeFile($file)
    const sized = $sizing.wait()
    const fs.FileSizeOutcome { File as measured Value as length } = sized
    const size = length else {
        return .Err(fault(.OutputUnavailable, "cannot measure the transcript"))
    }
    const seeking = spawn fs.SeekFile($measured, size)
    const sought = $seeking.wait()
    const fs.FileOutcome { File as positioned Value as moved } = sought
    moved else {
        return .Err(fault(.OutputUnavailable, "cannot reach the end of the transcript"))
    }
    var pending = own sink { file = positioned batch = text.NewBuilder() size = 0 }
    pending.size = text.ByteLen(data)
    append(&pending.batch, data)
    const closing = spawn closeSink($pending)
    const closed = $closing.wait()
    closed else error {
        return .Err(error)
    }
    .Ok
}

// A session Codex is still writing may end in a partly written line. Only the
// final line may fail to parse; an earlier malformed line stops the conversion.
fn acceptLine(
    &conv converter,
    line String,
    number u64,
    &lines fs.LineReader
) Result<void, failure> {
    const accepted = conv.Accept(line, number)
    match accepted {
        Ok: .Ok
        Err(error): match error.kind {
            MalformedRecord: {
                const next = lines.NextLimited(lineLimit()) else {
                    return .Err(error)
                }
                match next {
                    None: {
                        conv.counts.truncated += 1
                        .Ok
                    }
                    Some(extra): {
                        discard extra
                        .Err(error)
                    }
                }
            }
            _: .Err(error)
        }
    }
}

fn useGoal(&conv converter, $goal Option<codexGoal>) void {
    match goal {
        None: {}
        Some(found): {
            const codexGoal { objective status } = found
            conv.storedObjective = objective
            conv.storedStatus = status
        }
    }
}

task convertInto(
    $source String,
    $temporary String,
    $sessionID String,
    $transcript String,
    $title String,
    $goal Option<codexGoal>,
    $tracker own memoryTracker
) Result<conversion, failure> {
    const opened = fs.OpenLines(source) else {
        return .Err(fault(.SourceUnavailable, "cannot open " + source))
    }
    const opening = spawn fs.OpenFile($temporary, .Truncate)
    const openedFile = $opening.wait()
    const file = openedFile else {
        return .Err(fault(.OutputUnavailable, "cannot open the output file"))
    }
    var lines = opened
    var conv = newConverter(sessionID, transcript, title)
    conv.memories = tracker
    useGoal(&conv, $goal)
    var target = own sink { file = file batch = text.NewBuilder() size = 0 }
    var number u64 = 0
    var reading = true
    while reading {
        const next = lines.NextLimited(lineLimit()) else {
            return .Err(fault(.SourceUnavailable, "cannot read line " + format.U64(number + 1)))
        }
        match next {
            None: {
                reading = false
            }
            Some(line): {
                number = number + 1
                acceptLine(&conv, line, number, &lines) else error {
                    return .Err(error)
                }
            }
        }
        target.size = target.size + drain(&conv, &target.batch)
        if target.size >= chunkLimit() {
            const writing = spawn writeBatch($target)
            const outcome = $writing.wait()
            const sinkOutcome { target as returned result } = outcome
            target = returned
            result else error {
                return .Err(error)
            }
        }
    }
    conv.Finish() else error {
        return .Err(error)
    }
    target.size = target.size + drain(&conv, &target.batch)
    const closing = spawn closeSink($target)
    const closed = $closing.wait()
    closed else error {
        return .Err(error)
    }
    const memories = replace conv.memories with newMemoryTracker()
    .Ok(conversion { counts = conv.counts memories = memories })
}
